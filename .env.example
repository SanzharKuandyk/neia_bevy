# ── Application ─────────────────────────────────────────────────────
# "development" or "production" (controls log level: debug vs info)
APP_ENV=development
# Maximum number of rolling log files to keep
MAX_LOG_FILES=5

# ── Game Server (UDP / renet) ──────────────────────────────────────
GAME_SERVER_PROTOCOL_ID=7
GAME_SERVER_PORT=5000
GAME_SERVER_MAX_CLIENTS=16
GAME_SERVER_MAX_MEMORY_USAGE_BYTES=10485760
GAME_CLIENT_MAX_MEMORY_USAGE_BYTES=5242880
GAME_SERVER_AVAILABLE_BYTES_PER_TICK=65536
GAME_SERVER_DELTA_TIME_MS=50
GAME_SERVER_TOKEN_EXPIRE_SECONDS=300
GAME_SERVER_TIMEOUT_SECONDS=10

# Optional (defaults shown)
# GAME_SERVER_MAX_MESSAGES_PER_TICK=100
# GAME_SERVER_TICK_LATENCY_WARN_MS=10
# GAME_SERVER_CHANNEL_RESEND_TIME_MS=300

# ── HTTP Server (axum) ─────────────────────────────────────────────
HTTP_SERVER_PORT=3000
HTTP_SERVER_HEADER_VALUE=neia
HTTP_REQUEST_TIMEOUT=5000

# Optional (default shown)
# HTTP_MAX_REQUEST_BODY_SIZE=16384

# ── Shutdown ───────────────────────────────────────────────────────
# Optional (defaults shown)
# SHUTDOWN_TIMEOUT_SECS=30
# SHUTDOWN_GRACEFUL_WAIT_SECS=5
